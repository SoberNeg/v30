+        kw = {}
+        for k, v in colors.items():
+            kw[k] = v if theme == THEME_LIGHT else _v3074_dark_color(widget, v, _V3074_TAG_OPTS[k])
+        try:
+            orig_fn(widget, tag, None, **kw)
+        except Exception:
+            pass
